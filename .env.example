# Puerto donde escucha el servidor.
PORT=3000

# Origen permitido por CORS (el frontend).
FRONTEND_URL=http://localhost:5173

# Cadena de conexión a PostgreSQL.
DATABASE_URL=postgresql://usuario:clave@host:5432/base

# SSL de PostgreSQL: true en Neon; false en un PostgreSQL local sin SSL.
# "no-verify" desactiva la validación del certificado y solo debe usarse como
# último recurso.
DATABASE_SSL=true

# Preparar la base (esquema base + migraciones + seeds en orden):
#   DATABASE_URL=postgresql://usuario:clave@host:5432/base ./scripts/db-setup.sh
# Orden: db/init.sql (esquema base, una vez) → db/migrations/NNN_*.sql (si las
#        hay) → seed-seguridad → seed-usuario-prueba (con --with-test-user).

# Secreto para firmar las cookies de sesión. OBLIGATORIO en producción.
SESSION_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio

# Secreto para firmar los JWT de acceso (HS256). OBLIGATORIO en producción.
JWT_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio

# Vida del access token JWT (formato de jose: '15m', '1h', etc.). Default: 15m.
ACCESS_TOKEN_TTL=15m

# Vida del refresh token, en días. Default: 7.
REFRESH_TOKEN_TTL_DIAS=7

# Máximo de intentos fallidos antes de bloquear la cuenta (default: 5).
LOGIN_MAX_ATTEMPTS=5

# Minutos de bloqueo al alcanzar el máximo de intentos (default: 15).
LOGIN_BLOCK_MINUTES=15

# Pausa uniforme en ms (200–400) solo al fallar credenciales, para frenar
# fuerza bruta. 0 la desactiva; las pruebas corren con 0 (default: 400).
LOGIN_FAIL_DELAY_MS=400
